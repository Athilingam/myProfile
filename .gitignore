# ─────────────────────────────────────────────────────────────
#  Athilingam Portfolio — .gitignore
#  Stack: Next.js 15 · TypeScript · Tailwind · Vercel
# ─────────────────────────────────────────────────────────────

# Dependencies (reinstalled from lockfile — never commit)
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnpm-store/

# Next.js build & cache output (regenerated by `next build`)
/.next/
/out/
/build
next-env.d.ts

# Production bundles / exports
/dist

# Vercel (local project link + build artifacts)
.vercel

# TypeScript incremental build cache
*.tsbuildinfo

# Environment variables & secrets (commit ONLY the example)
.env
.env.*
!.env.example

# Tooling caches
.eslintcache
.stylelintcache
.cache
.turbo

# Test coverage
/coverage
*.lcov
.nyc_output

# Logs & debug output
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# Runtime / process files
pids
*.pid
*.seed
*.pid.lock

# Packaged tarballs (`npm pack`)
*.tgz

# Local certificates (e.g. `next dev --experimental-https`)
*.pem
certificates/

# ── OS-generated files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Editor / IDE files ──
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ── Misc local scratch (uncommitted personal notes) ──
*.local
/tmp
/temp
/.scratch
